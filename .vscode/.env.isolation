# ── Metal / ggml backend isolation ──────────────────────────────────────
# These env-vars instruct the embedded ggml-metallib in llama.cpp to
# flush its Metal resource-set cache on alloc/free rather than retaining
# objects across the process boundary. When this process dies (or is
# killed by VS Code), returning rsets to "zero" state so that a fresh
# llama.cpp invocation hits a cold cache and Ollama never sees stale
# device residency.

# 1. Zero-out the Metal resource-set allocator on every new context.
GGML_METAL_NO_RETAIN_MEMORY=1

# 2. Force llama.cpp onto GPU device 0.
#    Ollama typically takes device 0 first; by pinning llama.cpp to the
#    same id we make contention explicit and avoid the "dirty" cross-device
#    aliasing path that trips ggml-metal's assertion.
GGML_METAL_DEVICE_ID=0

# 3. Start from a cold resource cache — skip any on-disk persistence.
GGML_METAL_RESOURCE_CACHE=0

# ── llama.cpp server process ────────────────────────────────────────────
# Bound to loopback only; never leaks to the outside or touches Ollama's
# external API listener.
LLAMA_SERVER_HOST=127.0.0.1
LLAMA_SERVER_PORT=11345

# ── Ollama guards ──────────────────────────────────────────────────────
# These settings DO NOT modify your system Ollama install. They are
# process-scoped: if you ever launch Ollama from this workspace terminal,
# these env-vars take effect and keep it scrubbed of metal-state cruft.
OLLAMA_DEBUG=1
OLLAMA_KEEP_ALIVE=-1

# ── General development ────────────────────────────────────────────────
# Production-app Swift/Objective-C runtime noise suppression.
OS_ACTIVITY_MODE=disable
